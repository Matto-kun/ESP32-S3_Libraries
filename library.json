{
  "name": "ESP32-S3_Libraries",
  "version": "1.0.0",
  "description": "ESP32-S3 peripheral drivers (GPIO, SPI, I2C, UART, SD) and sensor APIs",
  "keywords": "esp32, esp32-s3, gpio, spi, i2c, uart, sd, sdspi, hmc5883l, hmc5983, amg8833, l76k, gnss, espidf",
  "authors": {
    "name": "Mat RB"
  },
  "license": "MIT",
  "frameworks": "espidf",
  "platforms": "espressif32",
  "build": {
    "includeDir": "include",
    "srcDir": "src",
    "srcFilter": [
      "-<*>",
      "+<gpio_api.cpp>",
      "+<spi_api.cpp>",
      "+<i2c_api.cpp>",
      "+<uart_api.cpp>",
      "+<sensors/hmc5883l_api.cpp>",
      "+<sensors/hmc5983_api.cpp>",
      "+<sensors/amg8833_api.cpp>",
      "+<sensors/l76k_api.cpp>",
      "+<sd_api.cpp>"
    ]
  }
}
